{
  "name": "@lcsync/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@lcsync/shared": "^1.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.3"
  },
  "scripts": {
