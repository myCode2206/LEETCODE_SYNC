# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of this backend; GitHub redirects to $PUBLIC_BASE_URL/api/v1/auth/github/callback
PUBLIC_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# ---- Database ----------------------------------------------------------------
# Postgres connection string. For local development without Postgres you may use an embedded
# database instead:  DATABASE_URL=pglite://./.data/dev-db
DATABASE_URL=postgres://lcsync:lcsync@localhost:5432/lcsync

# ---- GitHub OAuth App ----------------------------------------------------------
# Create at https://github.com/settings/developers → OAuth Apps.
# Authorization callback URL: $PUBLIC_BASE_URL/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Security ----------------------------------------------------------------
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated Chrome extension IDs allowed to sign in (see chrome://extensions).
ALLOWED_EXTENSION_IDS=
SESSION_TTL_DAYS=30
